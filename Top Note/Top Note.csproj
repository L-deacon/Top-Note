<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	  <TargetFramework>net8.0-windows7.0</TargetFramework>
	  
    <RootNamespace>Top_Note</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WinForms global usings are removed below to avoid name clashes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>TopNoteIcon.ico</ApplicationIcon>
	  <PlatformTarget>x64</PlatformTarget>
	  <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
	  <PublishSingleFile>false</PublishSingleFile>
	  <SelfContained>false</SelfContained>
	  <PublishTrimmed>false</PublishTrimmed>

  </PropertyGroup>

  <ItemGroup>
    <None Remove="NotesDB.db" />
  </ItemGroup>

  <!-- Notes are stored in %LocalAppData%TopNote, so the dev database is no longer shipped
       (shipping it overwrote users' notes on every ClickOnce update). -->
  <ItemGroup>
    <Content Include="TopNoteIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MvvmLightLibs" Version="5.4.1.1" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\PublishProfiles\" />
  </ItemGroup>

</Project>
