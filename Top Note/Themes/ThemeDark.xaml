<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <Color x:Key="BackgroundColor">#3B3B3B</Color>
    <Color x:Key="ForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="ToolBarColor">#171717</Color>
    <Color x:Key="ItemHoverColor">#FF4A4A4A</Color>
    <Color x:Key="ItemSelectedColor">#FF696969</Color>
    <Color x:Key="ListItemButtonHoverColor">#FF505050</Color>



    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource ForegroundColor}" />
    <SolidColorBrush x:Key="ToolBarBackGroundColor" Color="{DynamicResource ToolBarColor}" />

    <!-- Hover Colors -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FF696969" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="ListItemButtonHoverBrush" Color="#FFECECEC" />

    <!-- Images -->
    <BitmapImage x:Key="AddNoteIcon" UriSource="/Images/Dark/AddNoteImage.png" />
    <BitmapImage x:Key="ThemeToggleIcon" UriSource="/Images/sun.png" />
    <BitmapImage x:Key="PinnedIcon" UriSource="/Images/Dark/pinnedDark.png" />
    <BitmapImage x:Key="UnpinnedIcon" UriSource="/Images/Dark/unpinnedDark.png" />
    <BitmapImage x:Key="SaveIcon" UriSource="/Images/Dark/saveDark.png" />
    <BitmapImage x:Key="RefreshIcon" UriSource="/Images/Dark/refreshDark.png" />
    <BitmapImage x:Key="DeleteIcon" UriSource="/Images/delete.png" />


    <!-- Styles -->
    <Style x:Key="ToolBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#696969" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NoteWindowToolBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="#696969" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ListItemButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ListItemButtonHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBoxHoverStyle" TargetType="TextBlock">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#696969" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>