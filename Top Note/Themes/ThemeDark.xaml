<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark theme tokens. ThemeLight.xaml has exactly the same keys. -->
    <Color x:Key="WindowBgColor">#202020</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#202020" />
    <SolidColorBrush x:Key="Surface" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#323232" />
    <SolidColorBrush x:Key="Stroke" Color="#3A3A3A" />
    <SolidColorBrush x:Key="StrokeStrong" Color="#9A9A9A" />
    <SolidColorBrush x:Key="CardStroke" Color="#33000000" />
    <SolidColorBrush x:Key="SubtleHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtlePressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C8C8C8" />
    <SolidColorBrush x:Key="TextTertiary" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Accent" Color="#60CDFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#4CC2FF" />
    <SolidColorBrush x:Key="OnAccent" Color="#000000" />
    <SolidColorBrush x:Key="Danger" Color="#FF99A4" />
    <SolidColorBrush x:Key="Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="SnackbarBg" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SnackbarText" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SnackbarAccent" Color="#005FB8" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <sys:Double x:Key="ShadowOpacity">0.40</sys:Double>

</ResourceDictionary>
