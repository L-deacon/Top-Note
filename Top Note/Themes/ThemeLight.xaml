<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Light theme tokens. ThemeDark.xaml has exactly the same keys. -->
    <Color x:Key="WindowBgColor">#F3F3F3</Color>

    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#F9F9F9" />
    <SolidColorBrush x:Key="Stroke" Color="#E5E5E5" />
    <SolidColorBrush x:Key="StrokeStrong" Color="#8A8A8A" />
    <SolidColorBrush x:Key="CardStroke" Color="#14000000" />
    <SolidColorBrush x:Key="SubtleHover" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtlePressed" Color="#06000000" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5D5D5D" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Accent" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentHover" Color="#0067C0" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
    <SolidColorBrush x:Key="Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="SnackbarBg" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SnackbarText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SnackbarAccent" Color="#60CDFF" />
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C" />
    <sys:Double x:Key="ShadowOpacity">0.14</sys:Double>

</ResourceDictionary>
