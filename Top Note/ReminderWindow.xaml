<Window x:Class="Top_Note.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Top Note reminder" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" FontFamily="{StaticResource UiFont}">
    <!-- Margin leaves room for the shadow. -->
    <Border Margin="10" CornerRadius="10" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource StrokeStrong}" BorderThickness="1" Style="{StaticResource FlyoutShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="Strip" Background="{DynamicResource Accent}" CornerRadius="9,9,0,0" />

            <Grid Grid.Row="1" Margin="16,12,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="WhenText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10"
                        ToolTip="Dismiss" Click="Dismiss_Click" />
            </Grid>

            <TextBlock x:Name="TaskText" Grid.Row="2" Margin="16,4,16,0" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,14,14,14">
                <Button Content="Snooze 5 min" Style="{StaticResource TextLinkButton}" Margin="0,0,16,0"
                        VerticalAlignment="Center" Click="Snooze_Click" />
                <Button Style="{StaticResource AccentButton}" Click="Done_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource OnAccent}" />
                        <TextBlock Text="Done" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
