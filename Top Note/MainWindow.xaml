<Window x:Class="Top_Note.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Top_Note"
        xmlns:conv="clr-namespace:Top_Note.Converters"
        xmlns:viewModels="clr-namespace:Top_Note.ViewModels"
        d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Top Note" Height="450" Width="800" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--Tool Bar-->
        <Grid Grid.Row="0" Background="{DynamicResource ToolBarBackGroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <Grid HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Background="{DynamicResource ToolBarBackGroundColor}">
                <Button BorderThickness="0" Style="{DynamicResource ToolBarButtonStyle}" Command="{Binding NewNoteCommand}">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Image Source="{DynamicResource AddNoteIcon}" VerticalAlignment="Top"></Image>

                        <TextBlock VerticalAlignment="Bottom" Grid.Row="1">New Note</TextBlock>
                    </Grid>
                </Button>
            </Grid>

            <Grid HorizontalAlignment="Right" Grid.Row="0" Grid.Column="1" Background="{DynamicResource ToolBarBackGroundColor}">
                <Button BorderThickness="0" Command="{Binding ToggleThemeCommand}" Style="{DynamicResource ToolBarButtonStyle}">
                    <Image Source="{DynamicResource ThemeToggleIcon}" HorizontalAlignment="Right" Stretch="Uniform"></Image>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="5,5,5,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition Height="20"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Notes" HorizontalAlignment="Center" FontSize="20"></TextBlock>
                <Button HorizontalAlignment="Right" Style="{DynamicResource ToolBarButtonStyle}" Command="{Binding RefreshListCommand}">
                    <Image Source="{DynamicResource RefreshIcon}"></Image>
                </Button>
            </Grid>
            <TextBlock Grid.Row="1" Text="No notes found. Please create a new note." 
                       Visibility="{Binding NoNotesErrorMessageBool, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="Red" HorizontalAlignment="Center"></TextBlock>
            <Grid Grid.Row="2" Visibility="{Binding ShowListBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox x:Name="NotesListBox"
                         ItemsSource="{Binding Notes}"
                         Foreground="{DynamicResource ForegroundBrush}"
                         Background="{DynamicResource BackgroundBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="300"
                         MouseDoubleClick="NotesListBox_MouseDoubleClick">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{Binding Color, Converter={StaticResource StringToBrushConverter}}"/>
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Style="{DynamicResource ListItemButtonStyle}"
                                        ToolTip="Delete"
                                        Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="8,0,0,0">
                                    <Image Width="20" Height="20" Source="{DynamicResource DeleteIcon}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
