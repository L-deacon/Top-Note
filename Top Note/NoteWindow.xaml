<Window x:Class="Top_Note.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Top_Note.ViewModels"
        d:DataContext="{d:DesignInstance viewModels:NoteWindowViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="300" Height="300"
        MinWidth="200" MinHeight="120"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{Binding Colors.Body}"
        Foreground="{Binding Colors.Ink}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Loaded="NoteWindow_Loaded">

    <!-- Native window (rounded corners + shadow from Windows) with no title bar: we draw our own header. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseNoteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseNoteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveNoteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding TogglePinCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewNoteCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding DuplicateCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding BiggerTextCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding BiggerTextCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding SmallerTextCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding SmallerTextCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ResetTextSizeCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="Delete" Command="{Binding DeleteCommand}" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="#26000000" BorderThickness="0">
        <Grid x:Name="Root" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- Header: coloured strip, drag to move, double-click to roll up -->
            <Border x:Name="Header" Grid.Row="0" Background="{Binding Colors.Header}"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PinButton" Margin="2,0,0,0" Command="{Binding TogglePinCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NoteIconButton}">
                                <Setter Property="Content" Value="&#xE718;" />
                                <Setter Property="ToolTip" Value="Keep on top of every window (Ctrl+P)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Content" Value="&#xE841;" />
                                        <Setter Property="ToolTip" Value="Pinned on top — click to unpin (Ctrl+P)" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Title shows while the note is idle; the "Saved" hint while you work in it -->
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" Margin="6,0"
                               FontSize="12" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <StackPanel x:Name="SavedHint" Grid.Column="1" Orientation="Horizontal" Margin="6,0"
                                VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="10" Margin="0,1,5,0" />
                        <TextBlock Text="Saved" FontSize="11" />
                    </StackPanel>

                    <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Margin="0,0,2,0">
                        <!-- Only on today's daily task note -->
                        <Button x:Name="RefreshTasksButton" Content="&#xE72C;" Style="{StaticResource NoteIconButton}"
                                Click="RefreshTasks_Click" ToolTip="Refresh meetings from Outlook" Visibility="Collapsed" />
                        <Button Content="&#xE710;" Style="{StaticResource NoteIconButton}" Command="{Binding NewNoteCommand}"
                                ToolTip="New note (Ctrl+N)" />
                        <Button x:Name="ColorButton" Content="&#xE790;" Style="{StaticResource NoteIconButton}"
                                Click="ColorButton_Click" ToolTip="Note colour" />
                        <Button x:Name="MoreButton" Content="&#xE712;" Style="{StaticResource NoteIconButton}"
                                Click="MoreButton_Click" ToolTip="More options">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreMenu">
                                    <MenuItem x:Name="RollUpItem" Header="Roll up" InputGestureText="Ctrl+T" Click="RollUp_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE70E;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Checklist line" InputGestureText="Ctrl+L" Click="Checklist_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE9D5;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8F4;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Copy all text" Command="{Binding CopyTextCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8C8;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Open notes list" Command="{Binding ShowListCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8A7;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Delete note" InputGestureText="Ctrl+Shift+Del" Command="{Binding DeleteCommand}"
                                              Style="{StaticResource DangerMenuItem}">
                                        <MenuItem.Icon><TextBlock Text="&#xE74D;" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="&#xE8BB;" Style="{StaticResource NoteCloseButton}" Command="{Binding CloseNoteCommand}"
                                ToolTip="Close (Esc) — the note is kept in your list" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Colour picker flyout -->
            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom"
                   HorizontalOffset="-120" VerticalOffset="-6" AllowsTransparency="True" StaysOpen="False"
                   PopupAnimation="Fade" Closed="Flyout_Closed">
                <Grid Margin="12">
                    <Border Style="{StaticResource FlyoutShadow}" />
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                            CornerRadius="8" Padding="8,6,8,8">
                        <StackPanel>
                            <TextBlock Text="Colour" FontSize="12" Margin="4,0,0,4" Foreground="{DynamicResource TextSecondary}" />
                            <ItemsControl ItemsSource="{Binding Swatches}" Width="148">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding Color.Name}"
                                                Click="Swatch_Click" Tag="{Binding Color.BodyHex}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Popup>

            <!-- Body -->
            <TextBox x:Name="NoteText" Grid.Row="1"
                     Style="{StaticResource NoteTextBox}"
                     Background="Transparent"
                     Foreground="{Binding Colors.Ink}"
                     CaretBrush="{Binding Colors.Ink}"
                     SelectionBrush="{Binding Colors.Swatch}"
                     SelectionOpacity="0.45"
                     Padding="14,8,14,6"
                     FontFamily="{StaticResource UiFont}"
                     FontSize="{Binding SelectedFontSize}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     SpellCheck.IsEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="NoteText_PreviewKeyDown"
                     PreviewMouseLeftButtonDown="NoteText_PreviewMouseLeftButtonDown"
                     PreviewMouseWheel="NoteText_PreviewMouseWheel"
                     TextChanged="NoteText_TextChanged" />

            <TextBlock x:Name="Placeholder" Grid.Row="1" Text="Take a note…" Margin="16,8,16,0"
                       FontSize="{Binding SelectedFontSize}" Opacity="0.45" IsHitTestVisible="False" Visibility="Collapsed" />

            <!-- Footer: text size, checklist, edited time -->
            <Grid x:Name="Footer" Grid.Row="2" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Border BorderBrush="{Binding Colors.Divider}" BorderThickness="0,1,0,0" />
                <Grid Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="&#xE8E7;" Style="{StaticResource NoteIconButton}" FontSize="13"
                            Command="{Binding SmallerTextCommand}" ToolTip="Smaller text (Ctrl+−)" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedFontSize}" FontSize="11" Width="20" TextAlignment="Center"
                               VerticalAlignment="Center" Opacity="0.7" ToolTip="Text size (Ctrl+0 to reset)" />
                    <Button Grid.Column="2" Content="&#xE8E8;" Style="{StaticResource NoteIconButton}" FontSize="13"
                            Command="{Binding BiggerTextCommand}" ToolTip="Bigger text (Ctrl+=)" />
                    <Border Grid.Column="3" Width="1" Height="16" Margin="6,0" Background="{Binding Colors.Divider}" />
                    <Button Grid.Column="4" Content="&#xE9D5;" Style="{StaticResource NoteIconButton}" FontSize="13"
                            Click="Checklist_Click" ToolTip="Checklist (Ctrl+L) — type [] or - at the start of a line too" />
                    <TextBlock Grid.Column="5" Text="{Binding MetaText}" ToolTip="{Binding MetaToolTip}" FontSize="11"
                               Opacity="0.55" Margin="8,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
