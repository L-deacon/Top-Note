<Window x:Class="Top_Note.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Top_Note"
        xmlns:viewModels="clr-namespace:Top_Note.ViewModels"
        d:DataContext="{d:DesignInstance viewModels:NoteWindowViewModel}"
        mc:Ignorable="d"
        Width="250" Height="250"
        MinWidth="150"
        MinHeight="70"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        AllowsTransparency="True"
        BorderThickness="0"
        BorderBrush="Transparent"
        Topmost="{Binding IsPinned, Mode=TwoWay}">

    <Border 
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource ForegroundBrush}"
            BorderThickness="1"
            Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="20"></RowDefinition>
            </Grid.RowDefinitions>

            <Button Command="{Binding TogglePinCommand}"
        Style="{DynamicResource NoteWindowToolBarButtonStyle}"
        Grid.Row="0"
        Grid.Column="0" HorizontalAlignment="Left">

                <Image Width="20" Height="20">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{DynamicResource UnpinnedIcon}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Source" Value="{DynamicResource PinnedIcon}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

            </Button>


            <Button Command="{Binding SaveNoteCommand}"
                    Style="{DynamicResource NoteWindowToolBarButtonStyle}"
                    Grid.Row="0"
                    Grid.Column="0" HorizontalAlignment="Right">

                <Image Width="20" Height="20">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{DynamicResource SaveIcon}" />
                        </Style>
                    </Image.Style>
                </Image>

            </Button>

            <TextBox Grid.Row="1"
                Background="{Binding NoteColor}"
                Foreground="Black"
                BorderThickness="0"
                AcceptsReturn="True"
                TextWrapping="Wrap" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" FontSize="20"/>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0">
                <Button Command="{Binding ChangeColorCommand}" CommandParameter="#FFFF00">
                    <Image Source="Images/NotesColors/yellowSquare.png"></Image>
                </Button>
                <Separator Opacity="0" Width="5"/>
                <Button Command="{Binding ChangeColorCommand}" CommandParameter="#FFB026">
                    <Image Source="Images/NotesColors/orangeSquare.png"></Image>
                </Button>
                <Separator Opacity="0" Width="5"/>
                <Button Command="{Binding ChangeColorCommand}" CommandParameter="#99FFA9">
                    <Image Source="Images/NotesColors/greenSquare.png"></Image>
                </Button>
                <Separator Opacity="0" Width="5"/>
                <Button Command="{Binding ChangeColorCommand}" CommandParameter="#F7532D">
                    <Image Source="Images/NotesColors/redSquare.png"></Image>
                </Button>
                <Separator Opacity="0" Width="5"/>
                <Button Command="{Binding ChangeColorCommand}" CommandParameter="#E389FA">
                    <Image Source="Images/NotesColors/purpleSquare.png"></Image>
                </Button>
                <Separator Opacity="0" Width="5"/>
                <Button Command="{Binding ChangeColorCommand}" CommandParameter="#60ABFC">
                    <Image Source="Images/NotesColors/blueSquare.png"></Image>
                </Button>
            </StackPanel>
        </Grid>


    </Border>
</Window>